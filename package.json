{
  "name": "svg-editor-pj1",
  "version": "0.1.0",
  "private": true,
  "description": "A command-driven SVG editor for the Software Design PJ1 assignment",
  "type": "module",
  "workspaces": [
    "src/plugins/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./plugin-api": {
      "types": "./dist/plugin-api/index.d.ts",
      "default": "./dist/plugin-api/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:core && npm run build:plugins",
    "build:core": "tsc -p tsconfig.build.json",
    "build:plugins": "npm run build --workspaces --if-present",
    "cli": "npm run build && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}
